  'valve/tu/error_at.c',
  'valve/tu/error_count.c',
  'valve/tu/errors_foreach.c',
  'valve/tu/errors_print.c',
  'valve/tu/find_option_.c',
  'valve/tu/help_print_.c',
  'valve/tu/help_resolve.c',
  'valve/tu/help_resolve_internal_.c',
  'valve/tu/help_target.c',
  'valve/tu/option/annotations_print_.c',
  'valve/tu/option/array_free_.c',
  'valve/tu/option/c_locale_.c',
  'valve/tu/option/collides_with_globals_.c',
  'valve/tu/option/command_valid_.c',
  'valve/tu/option/conflict_count_.c',
  'valve/tu/option/conflicts_valid_.c',
  'valve/tu/option/duration_parse_.c',
  'valve/tu/option/find_command_.c',
  'valve/tu/option/have_duplicate_long_.c',
  'valve/tu/option/have_duplicate_short_.c',
  'valve/tu/option/in_.c',
  'valve/tu/option/kv_parse_.c',
  'valve/tu/option/label_.c',
  'valve/tu/option/label_print_.c',
  'valve/tu/option/mapped_.c',
  'valve/tu/option/option_count_.c',
  'valve/tu/option/option_name_valid_.c',
  'valve/tu/option/options_command_count_.c',
  'valve/tu/option/options_copy_.c',
  'valve/tu/option/options_have_invalid_.c',
  'valve/tu/option/options_use_reserved_.c',
  'valve/tu/option/repeat_valid_.c',
  'valve/tu/option/requirement_count_.c',
  'valve/tu/option/requirements_valid_.c',
  'valve/tu/option/scalar_auto_.c',
  'valve/tu/option/strtod_c_.c',
  'valve/tu/option/type_valid_.c',
  'valve/tu/option/usage_print_.c',
  'valve/tu/option/value_label_.c',
  'valve/tu/option/value_valid_.c',
  'valve/tu/option/visible_.c',
  'valve/tu/parse.c',
  'valve/tu/parse_command_.c',
  'valve/tu/path_split.c',
  'valve/tu/required_check_.c',
  'valve/tu/requirement/forward_seen_.c',
  'valve/tu/requirement/reverse_seen_.c',
  'valve/tu/requirement/vl_requirement_active_.c',
  'valve/tu/requirement/vl_requirement_add_.c',
  'valve/tu/requirement/vl_requirement_error_.c',
  'valve/tu/requirement/vl_requirement_exists_.c',
  'valve/tu/requirement/vl_requirements_check_.c',
  'valve/tu/requirement/vl_requirements_clear_.c',
  'valve/tu/requirement/vl_requirements_copy_.c',
  'valve/tu/requirement/vl_requirements_copy_table_.c',
  'valve/tu/reserved.c',
  'valve/tu/reserved_fired.c',
  'valve/tu/result/at.c',
  'valve/tu/result/count.c',
  'valve/tu/result/find_.c',
  'valve/tu/result/set_.c',
  'valve/tu/result/vl_results_clear_.c',
  'valve/tu/schema/validate_.c',
  'valve/tu/targets_clear.c',
  'valve/tu/value/clear.c',
  'valve/tu/value/has.c',
  'valve/tu/value/vl_get.c',
