  'valve/tu/verb/subverb_get.c',
  'valve/tu/verb/table_count_.c',
  'valve/tu/verb/verb_array_clear_.c',
  'valve/tu/verb/verb_copy_one_.c',
  'valve/tu/verb/verb_count_.c',
  'valve/tu/verb/verb_name_valid_.c',
  'valve/tu/verb/verbs_have_invalid_.c',
  'valve/tu/verb/verbs_use_reserved_.c',
  'valve/tu/verb/vl_verb_get.c',
  'valve/tu/version_get.c',
  'valve/tu/version_print_.c',
  'valve/tu/version_string.c',
  'valve/tu/vl_options_clear_.c',
)

valve_lib = library(
  'valve',
  valve_sources,
  include_directories: inc,
  c_args: valve_c_args,
  install: true,
  version: valve_version.split('-')[0],
  soversion: '0',
)

valve_dep = declare_dependency(
  include_directories: inc,
  link_with: valve_lib,
)

pkg = import('pkgconfig')
pkg.generate(
  name: 'valve',
  description: 'CLI args parsing library',
  version: valve_version,
  libraries: valve_lib,
  subdirs: '',
)
