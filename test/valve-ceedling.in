#!/bin/sh
# Generated by Meson. Runs Ceedling against the toolchain prepared for this
# build directory (compiler, gcov, gcovr). Coverage tasks also load the static
# gcov plugin mixin. Always invoke from the source tree root.
set -eu

CEEDLING='@CEEDLING@'
SOURCE_ROOT='@SOURCE_ROOT@'
TOOLCHAIN_MIXIN='@TOOLCHAIN_MIXIN@'
GCOV_MIXIN='@GCOV_MIXIN@'

need_gcov=0
for arg in "$@"; do
  case $arg in
    gcov|gcov:*)
      need_gcov=1
      ;;
  esac
done

cd "$SOURCE_ROOT"

if [ "$need_gcov" -eq 1 ]; then
  exec "$CEEDLING" --mixin "$GCOV_MIXIN" --mixin "$TOOLCHAIN_MIXIN" "$@"
fi

exec "$CEEDLING" --mixin "$TOOLCHAIN_MIXIN" "$@"
