---
# Generated by Meson for this build directory. Do not hand-edit the output.
# Declares complete tool tables (executable + arguments) so stock Ceedling
# 1.1.x never falls back to its frozen default strings, which it later mutates.
# Compiler, gcov, and gcovr come from the Meson-selected toolchain.
:tools:
  :test_compiler:
    :executable: >-
      @C_COMPILER@
    :arguments:
      - "-I\"${5}\""
      - "-D\"${6}\""
      - "-DGNU_COMPILER"
      - "-g"
      - "-c \"${1}\""
      - "-o \"${2}\""
      - "-MMD"
      - "-MF \"${4}\""
  :test_linker:
    :executable: >-
      @C_COMPILER@
    :arguments:
      - "${1}"
      - "${5}"
      - "-o \"${2}\""
      - ""
      - "${4}"
  :test_fixture:
    :executable: "${1}"
    :arguments: []
  :gcov_compiler:
    :executable: >-
      @C_COMPILER@
    :arguments:
      - "-g"
      - "-fprofile-arcs"
      - "-ftest-coverage"
      - "-I\"${5}\""
      - "-D\"${6}\""
      - "-DGCOV_COMPILER"
      - "-DCODE_COVERAGE"
      - "-c \"${1}\""
      - "-o \"${2}\""
      - "-MMD"
      - "-MF \"${4}\""
  :gcov_linker:
    :executable: >-
      @C_COMPILER@
    :arguments:
      - "-g"
      - "-fprofile-arcs"
      - "-ftest-coverage"
      - "${1}"
      - "${5}"
      - "-o \"${2}\""
      - "${4}"
  :gcov_fixture:
    :executable: "${1}"
    :arguments: []
  :gcov_summary:
    :executable: >-
      @GCOV_EXECUTABLE@
    :arguments:
      - "-n"
      - "-p"
      - "-b"
      - "-o \"${2}\""
      - "\"${1}\""
  :gcov_gcc_version:
    :executable: >-
      @C_COMPILER@
    :arguments:
      - "--version"
  :gcov_gcovr_version:
    :executable: >-
      @GCOVR_EXECUTABLE@
    :arguments:
      - "--version"
  :gcov_report:
    :executable: >-
      @GCOV_EXECUTABLE@
    :arguments:
      - "-b"
      - "-c"
      - "-r"
      - "-s \"${2}\""
      - "-x"
      - "${1}"
  :gcov_gcovr_report:
    :executable: >-
      @GCOVR_EXECUTABLE@
    :arguments:
      - "--root \"${1}\""
      - "--exclude \"${2}\""
      - "${3}"

:gcov:
  :gcovr:
    :gcov_executable: >-
      @GCOV_EXECUTABLE@
